# Copy to .env (git-ignored) or set these in your pipeline. All optional; defaults shown.
BIND_ADDR=127.0.0.1          # interface the port is published on; never 0.0.0.0 on a LAN (no authentication)
HOST_PORT=8484               # host port (the container always listens on 8484)
TZ=UTC                       # e.g. Europe/Berlin; affects "daily at" schedules
BUNNYSAVE_IMAGE=bunnysave:latest
CONTAINER_NAME=bunnysave
RESTART_POLICY=unless-stopped
DATA_DIR=./data              # host path for /data (DB, backups, keys, logs)
RESTORE_DIR=./restore        # host path for /restore
BUNNYSAVE_SCHEDULER=1        # 0 disables schedules

# Host filesystem source: HOSTFS_PATH=/ exposes the host; use HOSTFS_MODE=rw to allow restoring onto it
#HOSTFS_PATH=/
#HOSTFS_MODE=ro

# Container sources (set both to the same absolute path), SOURCE_MODE=ro|rw
#SOURCE_1=/opt/myapp
#SOURCE_1_AS=/opt/myapp
#SOURCE_MODE=ro

# Unattended encrypted schedules: key file on the host (preferred) or the key itself
#MASTER_KEY_FILE=/path/on/host/master_key.txt
#BUNNYSAVE_MASTER_KEY=
